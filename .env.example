# Copy to .env.local and fill in. Both values are safe to expose to the browser:
# access is enforced by Row Level Security, not by keeping these secret.
# NEVER put the service_role key in a VITE_ variable.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=paste-anon-or-publishable-key-here
